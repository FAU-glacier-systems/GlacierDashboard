[Unit]
Description=Glacier Evolution Dashboard, 3D (Dash via gunicorn)
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dashboard/code
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/dashboard-venv/bin/gunicorn --config /home/ubuntu/dashboard/deploy/gunicorn.conf.py glacier_dashboard_3d:server
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillMode=mixed
# the 3D app memory-maps one file per glacier (plus its properties on demand): more than the default 1024
LimitNOFILE=8192
TimeoutStopSec=30

# Resource limits (machine has ~3.8 GB RAM, no swap)
MemoryHigh=1500M
MemoryMax=2G

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# the 3D app caches terrain tiles here (the home directory is otherwise read-only)
ReadWritePaths=/home/ubuntu/.cache/glacier3d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true 
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
